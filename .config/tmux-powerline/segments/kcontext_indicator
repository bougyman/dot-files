#!/bin/bash
kube_context() {
  kubectl config current-context 2>/dev/null| awk '
    {
      n=split($1,arr,"-")
      if(n == 1) {
        print $1
        next
      }
      if(n == 2) {
        print arr[n-1]"-"arr[n]
      } else {
        print arr[n-2]"-"arr[n-1]"-"arr[n]
      }
    }'
}

printf "%s" "$(kube_context)"
